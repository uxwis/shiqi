{
  "name": "shiqi-community",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node server.mjs",
    "dev:memory": "node scripts/dev-memory.mjs",
    "prestart": "node scripts/startup.mjs",
    "start": "node server.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:e2e": "playwright test",
    "maintenance:run": "node scripts/maintenance.mjs",
    "db:preview": "node scripts/migrate.mjs --preview",
    "dev:local": "node scripts/dev-local.mjs",
    "demo:seed": "node scripts/demo-content.mjs"
  },
  "dependencies": {
    "nodemailer": "^9.0.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "pg-mem": "^3.0.5",
    "prettier": "^3.9.6"
  }
}
