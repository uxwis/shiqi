{
  "name": "shiqi-community",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node server.mjs",
    "dev:memory": "node scripts/dev-memory.mjs",
    "prestart": "node scripts/startup.mjs",
    "start": "node server.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "node --test --test-concurrency=1",
    "check": "node --check app.js && node --check server.mjs"
  },
  "dependencies": {
    "nodemailer": "^9.0.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "pg-mem": "^3.0.5"
  }
}
