# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173
TRUST_PROXY=false

# PostgreSQL (required outside automated tests)
DATABASE_URL=postgres://shiqi:change-me@127.0.0.1:5432/shiqi
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Authentication
SESSION_COOKIE_NAME=shiqi_session
SESSION_TTL_DAYS=30
PASSWORD_PEPPER=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NICKNAME=拾器运营
SEED_ON_START=false

# Email verification. Development prints codes to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=拾器 <no-reply@example.com>

# Uploads. Local storage requires a persistent disk in production.
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_PATH=/uploads
MAX_IMAGE_BYTES=524288
